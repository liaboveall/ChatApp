{
  "name": "chatapp",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "setup": "bun scripts/setup.ts",
    "doctor": "bun scripts/doctor.ts",
    "infra:up": "docker compose -f infra/compose.dev.yml --env-file .env.local up -d --wait",
    "infra:down": "docker compose -f infra/compose.dev.yml --env-file .env.local down",
    "infra:ps": "docker compose -f infra/compose.dev.yml --env-file .env.local ps",
    "infra:logs": "docker compose -f infra/compose.dev.yml --env-file .env.local logs -f --tail=100",
    "infra:bootstrap": "bun scripts/bootstrap-garage.ts",
    "infra:reset": "bun scripts/infra-reset.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun scripts/typecheck.ts",
    "guard": "bun scripts/guard.ts",
    "check": "bun run lint && bun run typecheck && bun run guard && bun run test:unit",
    "test:unit": "bun test ./scripts ./packages ./apps/server/src",
    "db:generate": "bun run --cwd packages/db generate",
    "db:check": "bun run --cwd packages/db check",
    "db:migrate": "bun --env-file=.env.local apps/server/src/cli.ts migrate",
    "db:migrate:test": "APP_ENV=test bun --env-file=.env.local apps/server/src/cli.ts migrate",
    "db:bootstrap": "bun --env-file=.env.local apps/server/src/cli.ts db:bootstrap",
    "db:bootstrap:test": "APP_ENV=test bun --env-file=.env.local apps/server/src/cli.ts db:bootstrap",
    "dev:api": "bun --env-file=.env.local --watch apps/server/src/api.ts",
    "dev:worker": "bun --env-file=.env.local --watch apps/server/src/worker.ts",
    "test:integration": "bun --env-file=.env.local test ./apps/server/test/integration ./apps/server/test/security ./apps/server/test/contract ./apps/server/test/realtime",
    "test": "bun run test:unit && bun run test:integration",
    "db:seed": "bun --env-file=.env.local apps/server/src/cli.ts db:seed",
    "admin:create": "bun --env-file=.env.local apps/server/src/cli.ts admin:create",
    "admin:verify-email": "bun --env-file=.env.local apps/server/src/cli.ts admin:verify-email",
    "test:infra:up": "bun scripts/test-infra.ts up",
    "test:infra:down": "bun scripts/test-infra.ts down",
    "test:fault": "bun scripts/test-fault.ts",
    "smoke:backend": "bun --env-file=.env.local scripts/smoke-backend.ts",
    "design:build": "bun design/prototype/tools/build.mjs",
    "design:contrast": "bun design/prototype/tools/contrast.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.15",
    "typescript": "7.0.2"
  }
}
