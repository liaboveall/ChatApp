[Unit]
Description=ChatApp backup, deletion and capacity monitoring
After=docker.service network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/chatapp/source
ExecStart=/usr/bin/docker compose --env-file /opt/chatapp/private/compose.env -f infra/compose.prod.yml run --rm --no-deps tools monitor
TimeoutStartSec=2min
UMask=0077
