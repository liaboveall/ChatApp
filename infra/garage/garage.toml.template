# Garage single-node config for local development.
# `bun run setup` renders this template into infra/garage/garage.toml (git-ignored),
# replacing {{...}} placeholders with values from .env.local.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "{{GARAGE_RPC_SECRET}}"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "{{GARAGE_ADMIN_TOKEN}}"
metrics_token = "{{GARAGE_METRICS_TOKEN}}"
