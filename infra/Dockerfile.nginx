# Patched standalone gateway for recovery/verification. The cloud host's Nginx is checked separately.
FROM nginx:1.30.6-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951
RUN apk upgrade --no-cache
ARG APPLICATION_SHA
ARG APPLICATION_SOURCE_HASH
LABEL org.opencontainers.image.revision=$APPLICATION_SHA chatapp.source-hash=$APPLICATION_SOURCE_HASH
