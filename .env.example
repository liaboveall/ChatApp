# ChatApp v2 — environment variables (local development)
# `bun run setup` copies this file to .env.local and fills every <generated> value.
# Never commit .env.local. Never paste secrets into chat, issues or logs.

APP_ENV=development
APP_ORIGIN=http://localhost:5173
API_PORT=3100
PRODUCT_NAME=ChatApp
AGENT_DISPLAY_NAME=助手
AGENT_USERNAME=assistant
LOG_LEVEL=info

# PostgreSQL 18 + pgvector (docker). Host port 5434: 5432 is taken by a native PostgreSQL on the dev machine.
POSTGRES_PASSWORD=<generated>
DATABASE_URL=<generated>
DATABASE_URL_TEST=<generated>

# Valkey (db 0 = dev, db 1 = tests)
VALKEY_URL=redis://localhost:6379/0
VALKEY_URL_TEST=redis://localhost:6379/1

# Garage (S3-compatible object storage)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=chatapp
S3_BUCKET_TEST=chatapp-test
S3_ACCESS_KEY_ID=<generated>
S3_SECRET_ACCESS_KEY=<generated>
GARAGE_RPC_SECRET=<generated>
GARAGE_ADMIN_TOKEN=<generated>
GARAGE_METRICS_TOKEN=<generated>

# Auth (Better Auth)
BETTER_AUTH_SECRET=<generated>

# Mail — Mailpit locally (web UI http://localhost:8025)
SMTP_HOST=localhost
# Also controls the Compose host port; change if Windows reserves or another process uses it.
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ChatApp <noreply@chatapp.localhost>"

# AI (DeepSeek) — fill in DEEPSEEK_API_KEY yourself
DEEPSEEK_API_KEY=
AI_MODEL_FAST=deepseek-flash
AI_MODEL_DEEP=deepseek-flash
AI_USER_DAILY_TOKENS=500000
AI_MONTHLY_BUDGET_USD=20
# Both modes use deepseek-flash (= DeepSeek-V4.1-Flash as of 2026-09-30); "deep" enables thinking (D-031).
# USD per 1M tokens, DeepSeek peak rates checked 2026-09-30 (used only for cost estimates)
AI_PRICE_FAST_INPUT_CACHE_HIT=0.006
AI_PRICE_FAST_INPUT=0.3
AI_PRICE_FAST_OUTPUT=1.2
AI_PRICE_DEEP_INPUT_CACHE_HIT=0.006
AI_PRICE_DEEP_INPUT=0.3
AI_PRICE_DEEP_OUTPUT=1.2

# Web Push (M6)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chatapp.localhost

# Development seed data
SEED_DEMO_PASSWORD=<generated>
