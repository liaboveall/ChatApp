# ChatApp v2 — environment variables (local development)
# `bun run setup` copies this file to .env.local and fills every <generated> value.
# Never commit .env.local. Never paste secrets into chat, issues or logs.

APP_ENV=development
APP_ORIGIN=http://localhost:5173
# Business time zone: daily quota reset and monthly budget (D-049).
APP_TIMEZONE=Asia/Shanghai
API_PORT=3100
# Loopback only. Inside a container (production compose) this is 0.0.0.0 with the port published on 127.0.0.1.
API_HOST=127.0.0.1
# Only these peers may set X-Forwarded-For / X-Real-IP (SEC-28).
TRUSTED_PROXIES=127.0.0.1,::1
PRODUCT_NAME=ChatApp
AGENT_DISPLAY_NAME=助手
AGENT_USERNAME=assistant
LOG_LEVEL=info

# Host ports of the containers (D-172). Windows reserves ranges of ports at random and Docker Desktop then publishes nothing,
# without an error; the reservations are taken out of Windows' dynamic port range, so the defaults sit above it (the usual
# port plus 20000: 5434 -> 25434, 6379 -> 26379). To move one, change it here and run `bun run setup` (it rewrites the ports
# in the URLs below), then `bun run infra:up`; `bun run doctor` says when one is reserved and which port to take instead.
POSTGRES_PORT=25434
VALKEY_PORT=26379

# PostgreSQL 18 + pgvector (docker); 5432 itself is taken by a native PostgreSQL on the dev machine.
# Two accounts (docs/04): the OWNER runs migrations, bootstrap and admin CLI commands; the application connects as
# an unprivileged role (DATABASE_URL) that cannot change the schema. `bun run db:migrate` creates that role.
POSTGRES_PASSWORD=<generated>
DATABASE_OWNER_URL=<generated>
DATABASE_OWNER_URL_TEST=<generated>
DATABASE_URL=<generated>
DATABASE_URL_TEST=<generated>

# Valkey (db 0 = dev, db 1 = tests); the port is VALKEY_PORT
VALKEY_URL=redis://localhost:26379/0
VALKEY_URL_TEST=redis://localhost:26379/1

# Garage (S3-compatible object storage)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=chatapp
S3_BUCKET_TEST=chatapp-test
S3_ACCESS_KEY_ID=<generated>
S3_SECRET_ACCESS_KEY=<generated>
GARAGE_RPC_SECRET=<generated>
GARAGE_ADMIN_TOKEN=<generated>
GARAGE_METRICS_TOKEN=<generated>

# Auth (Better Auth)
BETTER_AUTH_SECRET=<generated>
# Separate 32-byte key (base64url) that encrypts one-time email credentials waiting for delivery (D-076).
AUTH_TOKEN_ENCRYPTION_KEY=<generated>
# Disaster-recovery generation: every session, origin and credential carries it, so a restore that changes it
# invalidates all of them (docs/03 section 5.9). Never reuse an old value after a restore.
RESTORE_EPOCH=<generated>

# Mail — Mailpit locally (web UI http://localhost:8025)
SMTP_HOST=localhost
# Also controls the Compose host port; change if Windows reserves or another process uses it.
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ChatApp <noreply@chatapp.localhost>"

# AI — M4 defaults to the free NUS SoCLaaS trial. Fill in SOCLAAS_API_KEY yourself.
AI_PROVIDER=soclaas
SOCLAAS_API_KEY=
# Explicitly selecting AI_PROVIDER=deepseek uses this separate key; no automatic paid fallback.
DEEPSEEK_API_KEY=
AI_MODEL_FAST=x-test-1
AI_MODEL_DEEP=x-test-1
AI_USER_DAILY_TOKENS=500000
AI_MONTHLY_BUDGET_USD=20
# Paid synthetic experiments require an explicit reservation; the site gets the remainder of this monthly total.
AI_EXPERIMENT_BUDGET_USD=0
# SoCLaaS is accounted at $0; token/time/concurrency limits still apply.
# Rates below apply only if DeepSeek is explicitly selected, with its matching model IDs.
AI_PRICE_FAST_INPUT_CACHE_HIT=0.006
AI_PRICE_FAST_INPUT=0.3
AI_PRICE_FAST_OUTPUT=1.2
AI_PRICE_DEEP_INPUT_CACHE_HIT=0.006
AI_PRICE_DEEP_INPUT=0.3
AI_PRICE_DEEP_OUTPUT=1.2

# Web Push (M6)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chatapp.localhost

# Development seed data
SEED_DEMO_PASSWORD=<generated>
